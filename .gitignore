# All generated output belongs under build/ - scripts/hil points Twister there.
build*/
build/
build-*/
notes
notes.md
.west/
.cache/
.embedder/
# Belt and braces for runs started by hand: plain `west twister` defaults to
# ./twister-out, and its default policy renames the previous run to
# twister-out.1, .2, ... which a bare "twister-out/" rule does not match.
twister-out*/
*.log
compile_commands.json
.vscode/
.github/
