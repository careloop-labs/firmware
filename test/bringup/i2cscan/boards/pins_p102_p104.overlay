 *
 * Candidate A: SDA = P1.02, SCL = P1.04.
 *
 * This is what careloop_v2-pinctrl.dtsi currently ships. Its origin is a
 * comment claiming the pins were extracted from CareLoop.kicad_sch, which a
 * trace of that file does not reproduce - hence the scan.
 */

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 4)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 4)>;
			low-power-enable;
		};
	};
};

&i2c0 {
	status = "okay";
};
