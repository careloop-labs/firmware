# Memory protection / stack hardening
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# Console over SEGGER RTT. The wearable exposes no UART pads, so RTT rides the
# SWD lines already needed for flashing. UART0 stays described in DTS but
# disabled; enable it per-build when probing a bring-up jig.
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=n
CONFIG_SERIAL=n

# Buses and GPIO required by the on-board sensors. No SPI: the QSPI/SPI pins
# are unrouted and there is no external flash chip on this board.
CONFIG_GPIO=y
CONFIG_I2C=y

# Y4 32.768 kHz crystal is populated (XL1/P0.00, XL2/P0.01, 12 pF loading caps).
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_20PPM=y

# Note: NFCT pins are freed for GPIO use via the &uicr nfct-pins-as-gpios
# property in careloop.dts. The old CONFIG_NFCT_PINS_AS_GPIOS symbol was
# removed in Zephyr 3.5.
