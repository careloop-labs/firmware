 *
 * CareLoop Wearable v2 - nRF52840 (aQFN73).
 * Net names and pin numbers taken from CareLoop.kicad_sch.
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "careloop_v2-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "CareLoop Wearable v2";
	compatible = "careloop,careloop-v2";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	/*
	 * MAX17222 boost regulator (U8) generating +5V for the AFE LED
	 * (TX) supply. Held off at reset - the PPG LEDs are dark until
	 * this is enabled, so enable it before expecting optical data.
	 */
	afe_boost_en: afe-boost-en {
		compatible = "regulator-fixed";
		regulator-name = "afe_boost_5v";
		enable-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		startup-delay-us = <1000>;
	};
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;

	/*
	 * U3 - TMP117 skin temperature. ADD0 strapped to GND => 0x48.
	 * Driven by the generic ti,tmp11x driver. That binding has no
	 * alert property, so the ALERT line (U3.C2 -> P0.13) is not
	 * described here; drive it directly via gpio0 pin 13 if needed.
	 */
	tmp117: tmp11x@48 {
		compatible = "ti,tmp11x";
		reg = <0x48>;
	};

	/* U4 - BMI270 IMU. SDO strapped to GND => 0x68. CSB tied high => I2C mode. */
	bmi270: bmi270@68 {
		compatible = "bosch,bmi270";
		reg = <0x68>;
		irq-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>,
			    <&gpio0 9 GPIO_ACTIVE_HIGH>;
	};

	/* U2 - nPM1300 PMIC (charger, regulators, fuel gauge). */
	npm1300: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;
		status = "okay";
	};

	/*
	 * U7 - TI AFE4404 optical front end (PPG), NOT a MAX86178.
	 * Fixed I2C address 0x58. No upstream Zephyr driver exists yet,
	 * so this node stays disabled until a "ti,afe4404" binding and
	 * driver are written. Kept here so the wiring is recorded:
	 *   ADC_RDY (data ready) -> P0.12   [net /AFE/AFE_INT1]
	 *   RESETZ  (active low) -> P0.26   [net /AFE/AFE_INT2, misnamed]
	 *   LED supply           -> &afe_boost_en
	 */
	afe4404: afe4404@58 {
		compatible = "ti,afe4404";
		reg = <0x58>;
		status = "disabled";
		adc-rdy-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x0000C000>;
		};
		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000C000 0x00072000>;
		};
		slot1_partition: partition@7e000 {
			label = "image-1";
			reg = <0x0007E000 0x00072000>;
		};
		storage_partition: partition@f0000 {
			label = "storage";
			reg = <0x000F0000 0x00008000>;
		};
	};
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};
