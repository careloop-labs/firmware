 *
 * CareLoop Wearable main .dts file
 * when there is a new hardware revision available, export everything which does
 * not fit to the new revision into a .overlay file
 *
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/regulator/npm13xx.h>
#include <zephyr/dt-bindings/regulator/nrf5x.h>

/ {
	model = "CareLoop Wearable v2";
	compatible = "careloop,careloop-v2";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	/*
	 * TPSM81299 boost (U6) generating +5V for the AFE LEDs, gated by net
	 * BOOST_EN. Not regulator-boot-on: the PPG is out of scope until it
	 * has a driver, so the rail stays off and the pin is driven inactive.
	 * Pin unverified.
	 */
	afe_boost_en: afe-boost-en {
		compatible = "regulator-fixed";
		regulator-name = "afe_boost_5v";
		enable-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <1000>;
	};
};

/*
 * BMI270 INT2 is on P0.09, an NFC antenna pin at reset, so the pin is dead
 * as a GPIO without this. Written to UICR once by SoC init, which then
 * soft-resets - so the first flash after changing this needs a full erase
 * and a power cycle. Reads back 0xFFFFFFFE at 0x1000120C when applied.
 */
&uicr {
	nfct-pins-as-gpios;
};

/*
 * Do not switch REG1 to DC/DC. L13, the 15 nH DCC inductor, is not fitted
 * on current boards; without it NRF5X_REG_MODE_DCDC can leave the SoC
 * unstable or refusing to start, which presents exactly like a dead board.
 * LDO is already the upstream default - repeated here so the warning is
 * where someone would go looking. CONFIG_SOC_DCDC_NRF52X does the same
 * thing by another route.
 */
&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_LDO>;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;

	/* U3 - TMP117 skin temperature. ADD0 to GND => 0x48. */
	tmp117: tmp11x@48 {
		compatible = "ti,tmp11x";
		reg = <0x48>;
	};

	/*
	 * U4 - BMI270 IMU. SDO to GND => 0x68, CSB high => I2C mode.
	 * irq-gpios is [INT1, INT2]; the driver pins any-motion to INT1 and
	 * SENSOR_TRIG_DATA_READY to INT2. Both pins unverified.
	 *
	 * "bosch,bmi270-base" must stay. It has no binding file - it is a
	 * marker the driver tests with DT_INST_NODE_HAS_COMPAT to select the
	 * feature set, and "bosch,bmi270" supplies the actual binding.
	 * Without it the driver picks bmi270_feature_max_fifo, whose
	 * anymo_1/anymo_2 pointers are NULL, and SENSOR_TRIG_MOTION
	 * dereferences them. Address 0 is readable flash here, so nothing
	 * faults - it silently corrupts the sensor's feature config, on
	 * disable as well as enable.
	 *
	 * Changing this changes the config blob uploaded at init; re-run
	 * ./scripts/bringup.sh suite on hardware.
	 */
	bmi270: bmi270@68 {
		compatible = "bosch,bmi270-base", "bosch,bmi270";
		reg = <0x68>;
		irq-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>,
			    <&gpio0 9 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * U2 - nPM1300. Source of every rail: BUCK1 -> +1V8 (MCU, sensors,
	 * I2C pull-ups), BUCK2 -> +3V3, LDO1 -> +VLDO1 (AFE only). With no
	 * SAADC divider on the board, its VBAT ADC is the only way to read
	 * battery voltage.
	 *
	 * Its interrupt is left undescribed: mfd_npm13xx_init() hard-fails on
	 * any error in that path, so an unverified pin would break every
	 * PMIC-adjacent driver at once.
	 */
	npm1300: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;
		status = "okay";

		regulators {
			compatible = "nordic,npm1300-regulator";

			/*
			 * BUCK1 is the MCU's own supply, so min == max is
			 * load-bearing: regulator_common_init() snaps the
			 * output into range at boot, and a wrong range here
			 * browns out the CPU mid-init.
			 */
			npm1300_buck1: BUCK1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			npm1300_buck2: BUCK2 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};

			/* AFE supply - left off until the AFE has a driver. */
			npm1300_ldo1: LDO1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-allowed-modes = <NPM13XX_LDSW_MODE_LDO>;
				regulator-initial-mode = <NPM13XX_LDSW_MODE_LDO>;
			};
		};

		/*
		 * No thermistor is fitted, hence 0 ohms. Do not add any
		 * thermistor-*-millidegrees threshold: that path divides by
		 * the thermistor resistance.
		 */
		/*
		 * D4, D3 and D2 - three red indicator LEDs, and the only
		 * LEDs on the board that firmware can drive. Anodes sit on
		 * +3V3 (BUCK2); cathodes go straight to the PMIC's
		 * constant-current sinks LED0/LED1/LED2 (pads 25/26/27,
		 * traced in the PCB netlist). There are deliberately no
		 * series resistors - the sink sets the current.
		 *
		 * Host mode means software owns all three. The other two
		 * modes hand an LED to the PMIC's own charging or error
		 * indication, which is a product decision nobody has made
		 * yet; in either of them led_on() returns -EPERM.
		 *
		 * LED1 in afe.kicad_sch is unrelated - that is the SFH7074
		 * PPG emitter, driven by the AFE, and is out of scope.
		 */
		npm1300_leds: leds {
			compatible = "nordic,npm1300-led";
			nordic,led0-mode = "host";
			nordic,led1-mode = "host";
			nordic,led2-mode = "host";
		};

		npm1300_charger: charger {
			compatible = "nordic,npm1300-charger";
			term-microvolt = <4200000>;
			current-microamp = <50000>;
			dischg-limit-microamp = <200000>;
			vbus-limit-microamp = <500000>;
			thermistor-ohms = <0>;
			thermistor-beta = <3380>;
			charging-enable;
		};
	};

	/*
	 * U5, the optical front end, is a MAX86178ENJ+T and is deliberately
	 * absent: no Zephyr or NCS driver exists for it. It also needs both
	 * LDO1 and the +5V boost up before it will ACK. The "ti,afe4404" node
	 * that used to be here came from a stale BOM and matched no part on
	 * the board.
	 */
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x0000c000>;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 0x00072000>;
		};

		slot1_partition: partition@7e000 {
			label = "image-1";
			reg = <0x0007e000 0x00072000>;
		};

		storage_partition: partition@f0000 {
			label = "storage";
			reg = <0x000f0000 0x00008000>;
		};
	};
};

/* USB-C reaches the nPM1300 for charging and CC only - VBUS is not routed
 * to the MCU, so this never enumerates. Kept enabled as before.
 */
zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};
